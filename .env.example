# 你的 DeepSeek API Key（请在此处填入 sk- 开头的实际 Key）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=XXX
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# 单次请求 ReAct 决策轮上限（默认 15）
# HARNESS_MAX_ROUNDS=15

# 触发超长会话自动压缩的对话轮数阈值（默认 60 轮）
# HARNESS_COMPACT_ROUNDS=60

# 触发超长会话自动压缩的 token 阈值（默认 100000）
# HARNESS_COMPACT_TOKENS=100000

# 压缩时保留最近的未压缩对话轮数原文（默认 5 轮）
# HARNESS_KEEP_RECENT_ROUNDS=5

# 闲置会话判定秒数（默认 7200 秒，即 2 小时）
# HARNESS_IDLE_SECONDS=7200

# 闲置会话扫描后台线程周期秒数（默认 300 秒，即 5 分钟）
# HARNESS_SCAN_INTERVAL_SECONDS=300

# LLM API 请求超时时间（秒，默认 60.0）
# HARNESS_LLM_TIMEOUT_SECONDS=60.0

# LLM 请求失败时最大重试次数（默认 2）
# HARNESS_LLM_MAX_RETRIES=2

# 工具执行结果存入上下文的截断字符上限（默认 2000 字符）
# HARNESS_TOOL_RESULT_MAX_CHARS=2000
